{% comment %}
  Section: main-about
  File: sections/main-about.liquid

  Renders a rich "About Us" page with:
  - Hero banner with brand headline
  - Brand story (text + image)
  - Stats bar
  - Team grid
  - Values / pillars
  - Press logos (from theme editor)

  Usage: referenced by templates/page.about.json
{% endcomment %}

{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* ── Section spacing ── */
  .about-section-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .about-section-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── CSS tokens (match your luxe-theme.css if loaded, else standalone) ── */
  .about-page {
    --about-cream:     #F5F0EB;
    --about-stone:     #E8E0D5;
    --about-charcoal:  #1A1A18;
    --about-ink:       #2D2D2A;
    --about-muted:     #7A7570;
    --about-accent:    #C4A882;
    --about-accent-dk: #9E7E5A;
    --about-radius:    12px;
    --about-font-head: 'Cormorant Garamond', 'Georgia', serif;
    font-family: 'Jost', 'Inter', system-ui, sans-serif;
    color: var(--about-ink);
  }

  /* ── Hero ── */
  .about-hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 0 0 var(--about-radius) var(--about-radius);
  }
  .about-hero__bg {
    position: absolute; inset: 0;
    background-color: var(--about-charcoal);
  }
  .about-hero__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .55;
  }
  .about-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(26,26,24,.7) 0%, rgba(26,26,24,.1) 60%, transparent 100%);
  }
  .about-hero__content {
    position: relative;
    z-index: 2;
    padding: 4rem 5vw;
    color: #fff;
    max-width: 900px;
  }
  .about-hero__eyebrow {
    display: block;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .8;
    margin-bottom: 1rem;
  }
  .about-hero__headline {
    font-family: var(--about-font-head);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: 0 0 1.25rem;
  }
  .about-hero__sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: .85;
    max-width: 540px;
  }

  /* ── Story Grid ── */
  .about-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    padding: 6rem 5vw;
    max-width: 1280px;
    margin-inline: auto;
  }
  @media (max-width: 900px) {
    .about-story { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.5rem; }
    .about-story--reversed .about-story__media { order: -1; }
  }
  .about-story__media {
    border-radius: var(--about-radius);
    overflow: hidden;
    aspect-ratio: 4/5;
  }
  .about-story__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .6s cubic-bezier(.16,1,.3,1);
  }
  .about-story__media:hover img { transform: scale(1.04); }
  .about-story__eyebrow {
    display: inline-block;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--about-accent-dk);
    margin-bottom: 1.25rem;
  }
  .about-story__headline {
    font-family: var(--about-font-head);
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--about-charcoal);
    margin: 0 0 1.25rem;
  }
  .about-story__body {
    font-size: 1.0625rem;
    color: var(--about-muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  .about-story__cta {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    padding: .875rem 2rem;
    background: var(--about-charcoal);
    color: #fff;
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    border-radius: 9999px;
    text-decoration: none;
    transition: background .15s, box-shadow .15s;
  }
  .about-story__cta:hover {
    background: var(--about-ink);
    box-shadow: 0 4px 20px rgba(26,26,24,.25);
  }

  /* ── Stats Bar ── */
  .about-stats {
    background: var(--about-charcoal);
    color: #fff;
    padding: 3rem 5vw;
  }
  .about-stats__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 4rem;
    max-width: 1280px;
    margin-inline: auto;
  }
  .about-stat {
    text-align: center;
    min-width: 120px;
  }
  .about-stat__value {
    display: block;
    font-family: var(--about-font-head);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
    color: var(--about-accent);
  }
  .about-stat__label {
    display: block;
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.6);
    margin-top: .5rem;
  }

  /* ── Values Grid ── */
  .about-values {
    padding: 6rem 5vw;
    background: var(--about-cream);
  }
  .about-values__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .about-values__eyebrow {
    display: block;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--about-accent-dk);
    margin-bottom: 1rem;
  }
  .about-values__title {
    font-family: var(--about-font-head);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    color: var(--about-charcoal);
    margin: 0 0 1rem;
  }
  .about-values__subtitle {
    font-size: 1rem;
    color: var(--about-muted);
    line-height: 1.75;
  }
  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    max-width: 1280px;
    margin-inline: auto;
  }
  .about-value-card {
    background: #fff;
    border-radius: var(--about-radius);
    padding: 2.5rem 2rem;
    transition: box-shadow .2s;
  }
  .about-value-card:hover { box-shadow: 0 8px 40px rgba(0,0,0,.08); }
  .about-value-card__icon {
    width: 48px; height: 48px;
    background: var(--about-stone);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.5rem;
    color: var(--about-accent-dk);
  }
  .about-value-card__title {
    font-family: var(--about-font-head);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--about-charcoal);
    margin: 0 0 .75rem;
  }
  .about-value-card__body {
    font-size: .9375rem;
    color: var(--about-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ── Team Grid ── */
  .about-team {
    padding: 6rem 5vw;
    max-width: 1280px;
    margin-inline: auto;
  }
  .about-team__header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .about-team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2.5rem 2rem;
  }
  .about-team-card { text-align: center; }
  .about-team-card__photo {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--about-stone);
    margin: 0 auto 1.25rem;
    width: 160px; height: 160px;
    transition: transform .4s;
  }
  .about-team-card__photo img { width: 100%; height: 100%; object-fit: cover; }
  .about-team-card:hover .about-team-card__photo { transform: scale(1.04); }
  .about-team-card__name {
    font-family: var(--about-font-head);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--about-charcoal);
    margin: 0 0 .25rem;
  }
  .about-team-card__role {
    font-size: .8125rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--about-accent-dk);
  }
  .about-team-card__bio {
    font-size: .875rem;
    color: var(--about-muted);
    line-height: 1.6;
    margin-top: .75rem;
  }

  /* ── Press Logos ── */
  .about-press {
    padding: 4rem 5vw;
    border-top: 1px solid var(--about-stone);
    text-align: center;
  }
  .about-press__label {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--about-muted);
    margin-bottom: 2rem;
    display: block;
  }
  .about-press__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .about-press__logo img {
    height: 28px;
    width: auto;
    object-fit: contain;
    opacity: .45;
    filter: grayscale(1);
    transition: opacity .2s, filter .2s;
  }
  .about-press__logo img:hover { opacity: .9; filter: none; }

  /* ── Fade-up animation ── */
  @media (prefers-reduced-motion: no-preference) {
    .about-anim {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);
    }
    .about-anim.is-visible { opacity: 1; transform: translateY(0); }
    .about-anim-d1 { transition-delay: .1s; }
    .about-anim-d2 { transition-delay: .2s; }
    .about-anim-d3 { transition-delay: .3s; }
  }
{%- endstyle -%}

<div class="about-page about-section-padding">

  {%- comment -%} ── Hero ─────────────────────────────── {%- endcomment -%}
  {%- if section.settings.hero_image != blank or section.settings.hero_heading != blank -%}
    <div class="about-hero">
      <div class="about-hero__bg">
        {%- if section.settings.hero_image != blank -%}
          <img
            src="{{ section.settings.hero_image | image_url: width: 1800 }}"
            srcset="{{ section.settings.hero_image | image_url: width: 750 }} 750w,
                    {{ section.settings.hero_image | image_url: width: 1100 }} 1100w,
                    {{ section.settings.hero_image | image_url: width: 1800 }} 1800w"
            sizes="100vw"
            alt="{{ section.settings.hero_image.alt | default: shop.name | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ section.settings.hero_image.width }}"
            height="{{ section.settings.hero_image.height }}"
          >
        {%- endif -%}
      </div>
      <div class="about-hero__overlay"></div>
      <div class="about-hero__content">
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="about-hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.hero_heading != blank -%}
          <h1 class="about-hero__headline">{{ section.settings.hero_heading }}</h1>
        {%- else -%}
          <h1 class="about-hero__headline">{{ page.title }}</h1>
        {%- endif -%}
        {%- if section.settings.hero_subtext != blank -%}
          <p class="about-hero__sub">{{ section.settings.hero_subtext }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── Story Blocks ─────────────────────── {%- endcomment -%}
  {%- for block in section.blocks -%}

    {%- if block.type == 'story' -%}
      <div class="about-story{% if block.settings.reverse_layout %} about-story--reversed{% endif %} about-anim" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="about-story__media">
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 900 }} 900w"
              sizes="(max-width: 900px) 100vw, 50vw"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              loading="lazy"
              width="900"
              height="1125"
            >
          </div>
        {%- else -%}
          <div class="about-story__media" style="background: var(--about-stone);"></div>
        {%- endif -%}
        <div class="about-story__text">
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-story__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="about-story__headline">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="about-story__body rte">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
            <a href="{{ block.settings.cta_url }}" class="about-story__cta">
              {{ block.settings.cta_label }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

    {%- elsif block.type == 'stats' -%}
      <div class="about-stats" {{ block.shopify_attributes }}>
        <div class="about-stats__inner">
          {%- if block.settings.stat1_value != blank -%}
            <div class="about-stat about-anim">
              <span class="about-stat__value">{{ block.settings.stat1_value }}</span>
              <span class="about-stat__label">{{ block.settings.stat1_label }}</span>
            </div>
          {%- endif -%}
          {%- if block.settings.stat2_value != blank -%}
            <div class="about-stat about-anim about-anim-d1">
              <span class="about-stat__value">{{ block.settings.stat2_value }}</span>
              <span class="about-stat__label">{{ block.settings.stat2_label }}</span>
            </div>
          {%- endif -%}
          {%- if block.settings.stat3_value != blank -%}
            <div class="about-stat about-anim about-anim-d2">
              <span class="about-stat__value">{{ block.settings.stat3_value }}</span>
              <span class="about-stat__label">{{ block.settings.stat3_label }}</span>
            </div>
          {%- endif -%}
          {%- if block.settings.stat4_value != blank -%}
            <div class="about-stat about-anim about-anim-d3">
              <span class="about-stat__value">{{ block.settings.stat4_value }}</span>
              <span class="about-stat__label">{{ block.settings.stat4_label }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

    {%- elsif block.type == 'values' -%}
      <div class="about-values" {{ block.shopify_attributes }}>
        <div class="about-values__header about-anim">
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-values__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="about-values__title">{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="about-values__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}
        </div>
        <div class="about-values__grid">
          {%- for i in (1..4) -%}
            {%- liquid
              assign val_title = 'value' | append: i | append: '_title'
              assign val_body  = 'value' | append: i | append: '_body'
              assign val_icon  = 'value' | append: i | append: '_icon'
            -%}
            {%- if block.settings[val_title] != blank -%}
              <div class="about-value-card about-anim" style="transition-delay: {{ forloop.index0 | times: 0.1 }}s;">
                <div class="about-value-card__icon" aria-hidden="true">
                  {%- case block.settings[val_icon] -%}
                    {%- when 'leaf' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c1.49 0 2.9-.33 4.17-.91M12 2c5.52 0 10 4.48 10 10 0 2.21-.72 4.25-1.93 5.91M12 2v20"/></svg>
                    {%- when 'shield' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    {%- when 'heart' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    {%- else -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
                  {%- endcase -%}
                </div>
                <h3 class="about-value-card__title">{{ block.settings[val_title] }}</h3>
                <p class="about-value-card__body">{{ block.settings[val_body] }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- elsif block.type == 'team' -%}
      <div class="about-team" {{ block.shopify_attributes }}>
        <div class="about-team__header about-anim">
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-values__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="about-values__title">{{ block.settings.title }}</h2>
          {%- endif -%}
        </div>
        <div class="about-team__grid">
          {%- for i in (1..4) -%}
            {%- liquid
              assign tm_name  = 'member' | append: i | append: '_name'
              assign tm_role  = 'member' | append: i | append: '_role'
              assign tm_bio   = 'member' | append: i | append: '_bio'
              assign tm_photo = 'member' | append: i | append: '_photo'
            -%}
            {%- if block.settings[tm_name] != blank -%}
              <div class="about-team-card about-anim" style="transition-delay: {{ forloop.index0 | times: 0.12 }}s;">
                <div class="about-team-card__photo">
                  {%- if block.settings[tm_photo] != blank -%}
                    <img
                      src="{{ block.settings[tm_photo] | image_url: width: 320 }}"
                      alt="{{ block.settings[tm_name] | escape }}"
                      width="160" height="160"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>
                <p class="about-team-card__name">{{ block.settings[tm_name] }}</p>
                <p class="about-team-card__role">{{ block.settings[tm_role] }}</p>
                {%- if block.settings[tm_bio] != blank -%}
                  <p class="about-team-card__bio">{{ block.settings[tm_bio] }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- elsif block.type == 'press' -%}
      <div class="about-press" {{ block.shopify_attributes }}>
        {%- if block.settings.label != blank -%}
          <span class="about-press__label">{{ block.settings.label }}</span>
        {%- endif -%}
        <div class="about-press__logos">
          {%- for i in (1..5) -%}
            {%- assign logo_key = 'logo' | append: i -%}
            {%- assign logo_url_key = 'logo' | append: i | append: '_url' -%}
            {%- if block.settings[logo_key] != blank -%}
              {%- if block.settings[logo_url_key] != blank -%}
                <a href="{{ block.settings[logo_url_key] }}" class="about-press__logo" target="_blank" rel="noopener">
                  <img src="{{ block.settings[logo_key] | image_url: width: 300 }}" alt="Press logo {{ i }}" loading="lazy" height="28">
                </a>
              {%- else -%}
                <div class="about-press__logo">
                  <img src="{{ block.settings[logo_key] | image_url: width: 300 }}" alt="Press logo {{ i }}" loading="lazy" height="28">
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- elsif block.type == 'rich_text' -%}
      {%- comment -%} Full-width fallback block for page.content or custom text {%- endcomment -%}
      <div class="page-width page-width--narrow" style="padding: 4rem 1.5rem;" {{ block.shopify_attributes }}>
        {%- if block.settings.use_page_content -%}
          <div class="rte">{{ page.content }}</div>
        {%- elsif block.settings.content != blank -%}
          <div class="rte about-anim">{{ block.settings.content }}</div>
        {%- endif -%}
      </div>

    {%- endif -%}
  {%- endfor -%}

</div>

<script>
  /* Scroll reveal for .about-anim elements */
  (function () {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.about-anim').forEach(function(el) { el.classList.add('is-visible'); });
      return;
    }
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.about-anim').forEach(function(el) { obs.observe(el); });
  })();
</script>

{% schema %}
