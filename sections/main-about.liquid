{% comment %}
  Section: main-about
  File: sections/main-about.liquid
  Drop into: sections/
  Template: templates/page.about.json
{% endcomment %}

{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* ─── Section wrapper spacing ─── */
  .about-section-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .about-section-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ─── Design tokens: aligned with theme scale ─── */
  .about-page {
    --af-head: var(--font-heading-family);
    --af-body: var(--font-body-family);
    --af-sh: var(--font-heading-scale, 1);
    --af-sb: var(--font-body-scale, 1);
    --af-hw: var(--font-heading-weight, 400); 
    --af-hs: var(--font-heading-style, normal);

    --ac-fg: rgb(var(--color-foreground, 26 26 26));
    --ac-fg55: rgba(var(--color-foreground, 26 26 26), 0.75);
    --ac-fg12: rgba(var(--color-foreground, 26 26 26), 0.08);
    --ac-fg04: rgba(var(--color-foreground, 26 26 26), 0.03);
    --ac-bg: rgb(var(--color-background, 255 255 255));
    --ac-btn: rgb(var(--color-button, 26 26 26));
    --ac-btn-t: rgb(var(--color-button-text, 255 255 255));

    --ar: var(--inputs-radius, 0px); 
    --ar-btn: var(--buttons-radius, 0px);
    --amw: 1200px;

    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.5rem); 
    color: var(--ac-fg);
    background-color: var(--ac-bg);
    -webkit-font-smoothing: antialiased;
  }

  /* ═══════════════════════════════════════
     HERO — Normalized Clean Layout (No Black BG)
     ═══════════════════════════════════════ */
  .about-hero {
    position: relative;
    min-height: 45vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: transparent;
  }
  .about-hero__img {
    position: absolute; 
    inset: 0;
    width: 100%; 
    height: 100%;
    object-fit: cover;
    opacity: .15; 
    transform: scale(1.02);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .about-hero__gradient {
    position: absolute; 
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, var(--ac-bg) 100%);
    z-index: 1;
  }
  .about-hero__body {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 3rem 1.5rem;
    color: var(--ac-fg);
    max-width: 800px;
    margin-inline: auto;
  }
  .about-hero__eyebrow {
    display: block;
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.2rem);
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ac-fg55);
    margin-bottom: 1rem;
  }
  .about-hero__h1 {
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-style: var(--af-hs);
    font-size: calc(var(--af-sh) * 3.6rem); 
    line-height: 1.2;
    letter-spacing: normal;
    margin: 0 0 1.25rem;
  }
  .about-hero__sub {
    font-size: calc(var(--af-sb) * 1.6rem);
    line-height: 1.6;
    color: var(--ac-fg55);
    max-width: 580px;
    margin: 0 auto;
  }

  /* ═══════════════════════════════════════
     STORY — Standard Typography Scaling
     ═══════════════════════════════════════ */
  .about-story-wrap {
    width: 100%;
    padding: 5rem 5vw;
  }
  .about-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5vw;
    align-items: center;
    max-width: var(--amw);
    margin-inline: auto;
  }
  .about-story--rev { 
    grid-template-columns: 1fr 1fr;
  }
  .about-story--rev .about-story__media { order: 2; }
  .about-story--rev .about-story__text  { order: 1; }

  @media (max-width: 768px) {
    .about-story { grid-template-columns: 1fr !important; gap: 2.5rem; }
    .about-story--rev .about-story__media { order: unset; }
    .about-story-wrap { padding: 4rem 1.5rem; }
  }

  .about-story__media {
    border-radius: var(--ar);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--ac-fg04);
  }
  .about-story__media img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
  }

  .about-story__eyebrow {
    display: inline-block;
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.2rem);
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ac-fg55);
    margin-bottom: 1rem;
  }
  .about-story__h2 {
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-style: var(--af-hs);
    font-size: calc(var(--af-sh) * 2.8rem); 
    line-height: 1.2;
    color: var(--ac-fg);
    margin: 0 0 1.25rem;
  }
  .about-story__body {
    font-size: calc(var(--af-sb) * 1.5rem);
    color: var(--ac-fg55);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .about-story__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 2.2rem;
    background: var(--ac-btn);
    color: var(--ac-btn-t);
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.4rem);
    border-radius: var(--ar-btn);
    text-decoration: none;
    transition: opacity .3s ease;
  }
  .about-story__cta:hover { opacity: 0.85; }

  /* ═══════════════════════════════════════
     STATS BAR — Simplified Theme Contrast
     ═══════════════════════════════════════ */
  .about-stats {
    background: var(--ac-fg04);
    border-top: 1px solid var(--ac-fg12);
    border-bottom: 1px solid var(--ac-fg12);
    padding: 4rem 5vw;
  }
  .about-stats__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 2.5rem 0;
    max-width: var(--amw);
    margin-inline: auto;
  }
  .about-stat { 
    text-align: center; 
    flex: 1;
    min-width: 200px; 
    position: relative;
    padding-inline: 1.5rem;
  }
  .about-stat__val {
    display: block;
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-size: calc(var(--af-sh) * 3.2rem);
    line-height: 1.1;
    color: var(--ac-fg);
  }
  .about-stat__lbl {
    display: block;
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.2rem);
    color: var(--ac-fg55);
    margin-top: 0.5rem;
  }
  .about-stat:not(:last-child) { border-right: 1px solid var(--ac-fg12); }
  @media (max-width: 768px) { .about-stat { border-right: none !important; } }

  /* ═══════════════════════════════════════
     VALUES / PILLARS — Standard Proportions
     ═══════════════════════════════════════ */
  .about-values {
    padding: 6rem 5vw 4rem;
  }
  .about-values__hd {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }
  .about-eyebrow {
    display: block;
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.2rem);
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ac-fg55);
    margin-bottom: 0.75rem;
  }
  .about-section-title {
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-style: var(--af-hs);
    font-size: calc(var(--af-sh) * 3rem);
    color: var(--ac-fg);
    margin: 0 0 1rem;
    line-height: 1.2;
  }
  .about-section-sub {
    font-size: calc(var(--af-sb) * 1.5rem);
    color: var(--ac-fg55);
    line-height: 1.6;
    margin: 0;
  }
  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    max-width: var(--amw);
    margin-inline: auto;
  }
  .about-vcard {
    background: var(--ac-bg);
    border: 1px solid var(--ac-fg12);
    border-radius: var(--ar);
    padding: 2.5rem;
  }
  .about-vcard__icon {
    width: 20px; height: 20px;
    display: flex; align-items: center; justify-content: start;
    margin-bottom: 1.5rem;
    color: var(--ac-fg);
  }
  .about-vcard__title {
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-size: calc(var(--af-sh) * 2rem);
    color: var(--ac-fg);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }
  .about-vcard__body {
    font-size: calc(var(--af-sb) * 1.4rem);
    color: var(--ac-fg55);
    line-height: 1.6;
    margin: 0;
  }

  /* ═══════════════════════════════════════
     TEAM — Clean 3-Card Grid Configuration
     ═══════════════════════════════════════ */
  .about-team {
    padding: 4rem 5vw 6rem;
    max-width: var(--amw);
    margin-inline: auto;
  }
  .about-team__hd { 
    text-align: center; 
    margin-bottom: 4rem; 
  }
  .about-team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2.5rem;
  }
  @media (max-width: 990px) {
    .about-team__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 550px) {
    .about-team__grid { grid-template-columns: 1fr; }
  }
  .about-tcard { 
    text-align: center; 
  }
  .about-tcard__photo {
    width: 100%;
    aspect-ratio: 1 / 1; 
    border-radius: var(--ar);
    overflow: hidden;
    background: var(--ac-fg04);
    margin: 0 auto 1.5rem;
    border: 1px solid var(--ac-fg12);
  }
  .about-tcard__photo img {
    display: block; 
    width: 100%; 
    height: 100%; 
    object-fit: cover;
  }
  .about-tcard__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ac-fg04);
    color: var(--ac-fg55);
  }
  .about-tcard__placeholder svg {
    width: 40px;
    height: 40px;
    opacity: 0.4;
  }
  .about-tcard__name {
    font-family: var(--af-head);
    font-weight: var(--af-hw);
    font-size: calc(var(--af-sh) * 1.8rem);
    color: var(--ac-fg);
    margin: 0 0 .4rem;
  }
  .about-tcard__role {
    font-family: var(--af-body);
    font-size: calc(var(--af-sb) * 1.3rem);
    color: var(--ac-fg55);
    display: block;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .about-tcard__bio {
    font-size: calc(var(--af-sb) * 1.4rem);
    color: var(--ac-fg55);
    line-height: 1.5;
    margin: 1rem 0 0;
  }

  /* ─── Standard Dawn Reveal Easing ─── */
  @media (prefers-reduced-motion: no-preference) {
    .anim-up {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity .5s ease, transform .5s ease;
    }
    .anim-up.visible { opacity: 1; transform: none; }
    .anim-d1 { transition-delay: .05s; }
    .anim-d2 { transition-delay: .1s; }
    .anim-d3 { transition-delay: .15s; }
  }
{%- endstyle -%}

<div class="about-page about-section-padding">

  {%- comment -%}══ HERO ══{%- endcomment -%}
  {%- if section.settings.hero_heading != blank or section.settings.hero_image != blank -%}
    <div class="about-hero">
      {%- if section.settings.hero_image != blank -%}
        <img
          class="about-hero__img"
          src="{{ section.settings.hero_image | image_url: width: 1500 }}"
          srcset="{{ section.settings.hero_image | image_url: width: 750 }} 750w,
                  {{ section.settings.hero_image | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          alt="{{ section.settings.hero_image.alt | default: shop.name | escape }}"
          loading="eager"
          fetchpriority="high"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
        >
      {%- endif -%}
      <div class="about-hero__gradient"></div>
      <div class="about-hero__body">
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="about-hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.hero_heading != blank -%}
          <h1 class="about-hero__h1">{{ section.settings.hero_heading }}</h1>
        {%- else -%}
          <h1 class="about-hero__h1">{{ page.title }}</h1>
        {%- endif -%}
        {%- if section.settings.hero_subtext != blank -%}
          <p class="about-hero__sub">{{ section.settings.hero_subtext }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}══ BLOCKS ══{%- endcomment -%}
  {%- for block in section.blocks -%}

    {%- if block.type == 'story' -%}
      <div class="about-story-wrap" {{ block.shopify_attributes }}>
        <div class="about-story{% if block.settings.reverse_layout %} about-story--rev{% endif %} anim-up">
          <div class="about-story__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 500 }} 500w,
                        {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 768px) 100vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
                width="800" height="800"
              >
            {%- endif -%}
          </div>
          <div class="about-story__text">
            {%- if block.settings.eyebrow != blank -%}
              <span class="about-story__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="about-story__h2">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="about-story__body rte">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}" class="about-story__cta">
                {{ block.settings.cta_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

    {%- elsif block.type == 'stats' -%}
      <div class="about-stats" {{ block.shopify_attributes }}>
        <div class="about-stats__inner">
          {%- for i in (1..4) -%}
            {%- assign sv = 'stat' | append: i | append: '_value' -%}
            {%- assign sl = 'stat' | append: i | append: '_label' -%}
            {%- if block.settings[sv] != blank -%}
              {%- assign dc = '' -%}
              {%- if forloop.index == 2 %}{%- assign dc = ' anim-d1' -%}{%- endif -%}
              {%- if forloop.index == 3 %}{%- assign dc = ' anim-d2' -%}{%- endif -%}
              {%- if forloop.index == 4 %}{%- assign dc = ' anim-d3' -%}{%- endif -%}
              <div class="about-stat anim-up{{ dc }}">
                <span class="about-stat__val">{{ block.settings[sv] }}</span>
                <span class="about-stat__lbl">{{ block.settings[sl] }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- elsif block.type == 'values' -%}
      <div class="about-values" {{ block.shopify_attributes }}>
        <div class="about-values__hd anim-up">
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="about-section-title">{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="about-section-sub">{{ block.settings.subtitle }}</p>
          {%- endif -%}
        </div>
        <div class="about-values__grid">
          {%- for i in (1..4) -%}
            {%- liquid
              assign vt = 'value' | append: i | append: '_title'
              assign vb = 'value' | append: i | append: '_body'
              assign vi = 'value' | append: i | append: '_icon'
            -%}
            {%- if block.settings[vt] != blank -%}
              <div class="about-vcard anim-up">
                <div class="about-vcard__icon" aria-hidden="true">
                  {%- case block.settings[vi] -%}
                    {%- when 'leaf' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3s14-1 17 17C9 22 3 12 3 12S5 7 5 3z"/></svg>
                    {%- when 'shield' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    {%- when 'heart' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    {%- when 'star' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    {%- else -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
                  {%- endcase -%}
                </div>
                <h3 class="about-vcard__title">{{ block.settings[vt] }}</h3>
                {%- if block.settings[vb] != blank -%}
                  <p class="about-vcard__body">{{ block.settings[vb] }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

    {%- elsif block.type == 'team' -%}
      <div class="about-team" {{ block.shopify_attributes }}>
        <div class="about-team__hd anim-up">
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="about-section-title">{{ block.settings.title }}</h2>
          {%- endif -%}
        </div>
        <div class="about-team__grid">
          {%- for i in (1..3) -%}
            {%- liquid
              assign tn = 'member' | append: i | append: '_name'
              assign tr = 'member' | append: i | append: '_role'
              assign tb = 'member' | append: i | append: '_bio'
              assign tp = 'member' | append: i | append: '_photo'
            -%}
            <div class="about-tcard anim-up">
              <div class="about-tcard__photo">
                {%- if block.settings[tp] != blank -%}
                  <img
                    src="{{ block.settings[tp] | image_url: width: 400 }}"
                    alt="{{ block.settings[tn] | default: 'Team Member' | escape }}"
                    width="400" height="400"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="about-tcard__placeholder">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  </div>
                {%- endif -%}
              </div>
              <h3 class="about-tcard__name">
                {{ block.settings[tn] | default: "Team Member Name" }}
              </h3>
              <span class="about-tcard__role">
                {{ block.settings[tr] | default: "Role / Position" }}
              </span>
              {%- if block.settings[tb] != blank -%}
                <p class="about-tcard__bio">{{ block.settings[tb] }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

    {%- endif -%}
  {%- endfor -%}

</div>

<script>
(function () {
  var els = document.querySelectorAll('.anim-up');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if (en.isIntersecting) { en.target.classList.add('visible'); io.unobserve(en.target); }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });
  els.forEach(function(e){ io.observe(e); });
})();
</script>

{% schema %}
{
  "name": "About Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
